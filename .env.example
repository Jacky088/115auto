# docker compose 环境变量示例：复制为 .env 后按需修改（.env 已在 .gitignore 中，切勿提交真实密码）
# 用法：cp .env.example .env && docker compose up -d --build

# 监听地址：默认 0.0.0.0（局域网/公网可访问）。
# 只想本机访问（配合反向代理或 SSH 隧道）时改为 127.0.0.1
PAN_BIND_IP=0.0.0.0

# 初始登录用户名（登录后可在网页右上角修改）
WEB_USERNAME=admin

# 初始登录密码：留空 = 首次启动自动生成随机密码
# 随机密码看 `docker compose logs` 或 data/initial_password.txt，登录改密后该文件自动删除
WEB_PASSWORD=

# 反向代理地址（逗号分隔 IP/CIDR）：仅这些来源的 X-Forwarded-For / X-Forwarded-Proto 会被信任。
# 用 Nginx / Caddy / Cloudflare Tunnel 暴露到公网时必须填代理的内网地址，否则 Cookie 不带 Secure、
# 登录限速看到的也是代理 IP
TRUSTED_PROXIES=

# 时区（每日摘要按 Asia/Shanghai 判定）
TZ=Asia/Shanghai
